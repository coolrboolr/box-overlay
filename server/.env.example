PORT=5000
ALLOWED_EXTENSION_IDS=
ENABLE_DEV_EXTENSION_REGISTRATION=true
DEV_EXTENSION_REGISTRY_FILE=.cache/dev-extension-origins.json
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=20000
MOCK_OLLAMA=false
MOCK_OLLAMA_FALLBACK=false
ENABLE_BATCH_ANALYZE=false
MEMORY_ENABLED=false
MEMORY_DB_PATH=.cache/memory-store.json
MEMORY_EMBED_MODEL=mxbai-embed-large
MEMORY_EMBED_MODEL_VERSION=
MEMORY_DEDUP_THRESHOLD=0.9
MEMORY_DEDUP_KEY=cosine
MEMORY_MAX_CHARS_PER_CHUNK=1000
MEMORY_COMPACTION_INTERVAL=50
MEMORY_MAX_FILTER_DAYS=90
USE_FAKE_EMBEDDINGS=false
ENABLE_MEMORY_ANSWERS=false
ENABLE_MEMORY_ADMIN=false
