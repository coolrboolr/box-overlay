{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "types": ["chrome", "vitest/globals"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
